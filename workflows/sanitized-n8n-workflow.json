{
  "_comment": "Sanitized n8n workflow export. All credentials, tokens, IDs, and personal values have been replaced with named placeholders. Replace each placeholder with your own values before importing.",
  "_placeholders": {
    "TELEGRAM_CREDENTIAL": "Create a Telegram Bot API credential in n8n Settings > Credentials. Paste your bot token there.",
    "GOOGLE_DRIVE_CREDENTIAL": "Create a Google Drive OAuth2 credential in n8n. Authorize with the Google account that owns your Drive.",
    "GOOGLE_DRIVE_FOLDER_ID": "The ID of your raw/Inbox folder in Google Drive. Find it in the folder URL: drive.google.com/drive/folders/<FOLDER_ID>",
    "ANTHROPIC_CREDENTIAL": "Create an Anthropic API credential in n8n. Paste your API key there.",
    "WEBHOOK_ID": "Generated by n8n when you activate the workflow. Leave blank — n8n fills this in."
  },
  "name": "Telegram Intake Agent v2",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "node-telegram-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [180, 300],
      "webhookId": "[WEBHOOK_ID]",
      "credentials": {
        "telegramApi": {
          "id": "[TELEGRAM_CREDENTIAL_ID]",
          "name": "[TELEGRAM_CREDENTIAL]"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-text-check",
              "leftValue": "={{ $json.message.text }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if-text-or-binary",
      "name": "If",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "driveId": {
          "__rl": true,
          "value": "My Drive",
          "mode": "list",
          "cachedResultName": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "value": "[GOOGLE_DRIVE_FOLDER_ID]",
          "mode": "id"
        },
        "name": "={{ 'intake-' + $now.toFormat('yyyy-MM-dd-HHmmss') + '.md' }}",
        "content": "={{ '---\\ndate: ' + $now.toFormat('yyyy-MM-dd') + '\\nfrom: ' + ($json.message.from.first_name || $json.message.from.username || 'unknown') + '\\nstatus: unprocessed\\n---\\n\\n## Original Message\\n\\n' + $json.message.text }}",
        "options": {}
      },
      "id": "node-create-from-text",
      "name": "Create file from text",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [620, 200],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "[GOOGLE_DRIVE_CREDENTIAL_ID]",
          "name": "[GOOGLE_DRIVE_CREDENTIAL]"
        }
      }
    },
    {
      "parameters": {
        "driveId": {
          "__rl": true,
          "value": "My Drive",
          "mode": "list",
          "cachedResultName": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "value": "[GOOGLE_DRIVE_FOLDER_ID]",
          "mode": "id"
        },
        "inputDataFieldName": "data",
        "options": {}
      },
      "id": "node-upload-file",
      "name": "Upload file",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [620, 400],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "[GOOGLE_DRIVE_CREDENTIAL_ID]",
          "name": "[GOOGLE_DRIVE_CREDENTIAL]"
        }
      }
    },
    {
      "parameters": {
        "chatId": "[CHAT_ID_REMOVED]",
        "text": "Ontvangen ✅ Opgeslagen in raw/Inbox. Status: unprocessed.\n\nThis message was sent automatically with n8n",
        "additionalFields": {}
      },
      "id": "node-send-confirmation",
      "name": "Send a text message",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [840, 300],
      "credentials": {
        "telegramApi": {
          "id": "[TELEGRAM_CREDENTIAL_ID]",
          "name": "[TELEGRAM_CREDENTIAL]"
        }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "If",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If": {
      "main": [
        [
          {
            "node": "Create file from text",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Upload file",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create file from text": {
      "main": [
        [
          {
            "node": "Send a text message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload file": {
      "main": [
        [
          {
            "node": "Send a text message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "[VERSION_ID_REMOVED]",
  "id": "[WORKFLOW_ID_REMOVED]",
  "tags": []
}
